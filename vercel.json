{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.flockline.app"
        }
      ],
      "destination": "https://flockline.app/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.flockline.app"
        }
      ],
      "destination": "https://flockline.app/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/illustration-prewarm?region=nationwide",
      "schedule": "0,20 13 * * 1"
    },
    {
      "path": "/api/cron/weekly-digests?region=nationwide&mode=check",
      "schedule": "45 13 * * 1"
    },
    {
      "path": "/api/cron/weekly-digests?region=nationwide",
      "schedule": "0,15,30,45 14,15 * * 1"
    },

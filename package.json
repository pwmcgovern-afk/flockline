{
  "name": "flockline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev:api\" \"vite --host 127.0.0.1\"",
    "dev:api": "PORT=8787 node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "og": "node scripts/render-og.mjs",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "playwright": "^1.61.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4"
  }
}

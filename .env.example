EBIRD_API_KEY=your_ebird_api_key_here
PORT=8787

# Optional: enables Claude-written Insights findings.
# Without it, Insights still work using deterministic templated text.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: enables confirmed regional weekly email subscriptions through Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Flockline <digest@flockline.app>
RESEND_REPLY_TO=reply@flockline.app
RESEND_DIGEST_SEGMENT_ID=your_resend_segment_id
RESEND_TOPIC_NATIONWIDE=your_resend_topic_id
RESEND_TOPIC_NORTHEAST=your_resend_topic_id
RESEND_TOPIC_MIDWEST=your_resend_topic_id
RESEND_TOPIC_SOUTH=your_resend_topic_id
RESEND_TOPIC_WEST=your_resend_topic_id
DIGEST_SIGNING_SECRET=use_a_long_random_value
CRON_SECRET=use_a_different_long_random_value
PUBLIC_APP_URL=https://flockline.app
